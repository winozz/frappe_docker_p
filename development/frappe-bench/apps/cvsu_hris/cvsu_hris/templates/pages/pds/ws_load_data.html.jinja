{% set pagibig_id=frappe.get_all("ID", filters={"parent": doc.employee, "parenttype": "Employee", "id_selected_type": "PAG-IBIG"}, fields=["id_number"]) | list %}

{# <!--philhealth id--> #}
{% set philhealth_id=frappe.get_all("ID", filters={"parent": doc.employee, "parenttype": "Employee", "id_selected_type": "PHILHEALTH"}, fields=["id_number"]) | list %}

{# <!--philsys id--> #}
{% set philsys_id=frappe.get_all("ID", filters={"parent": doc.employee, "parenttype": "Employee", "id_selected_type": "PHILSYS"}, fields=["id_number"]) | list %}

{# <!--tin id--> #}
{% set tin_id=frappe.get_all("ID", filters={"parent": doc.employee, "parenttype": "Employee", "id_selected_type": "TIN"}, fields=["id_number"]) | list %}

{# <!--spouse--> #}
{% set spouse=frappe.get_all("Family Background", filters={"parent": doc.employee, "parenttype": "Employee", "relationship": "Spouse"}, fields=["first_name","surname","middle_name","name_extension","occupation","employers_business_name","employers_business_address","telephone_number"]) | list %}

